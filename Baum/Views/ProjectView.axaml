<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Baum.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:ProjectViewModel"
             x:Class="Baum.Views.ProjectView">
  <StackPanel>
    <TextBox Text="{Binding TextBoxContent}"/>
    <Button Content="Add" Command="{Binding AddWordCommand}"/>
    <ItemsControl ItemsSource="{Binding Words}">
    </ItemsControl>
  </StackPanel>
</UserControl>
